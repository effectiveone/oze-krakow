---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="OZE Kraków — Energia odnawialna w Małopolsce">
  <div class="container" style="padding-top:3rem;">
    <div class="hero-text">
      <span class="hero-label">Portal lokalny</span>
      <h1>Energia odnawialna<br/>w Krakowie i Małopolsce</h1>
      <p class="lead">Rzetelne informacje o fotowoltaice, pompach ciepła, biogazie i polityce energetycznej w Małopolsce.</p>
    </div>

    {posts.length > 0 ? (
      <>
        <h2 class="section-h">Najnowsze wpisy</h2>
        {posts.slice(0, 8).map(p => <PostCard title={p.data.title} description={p.data.description} slug={p.slug} pubDate={p.data.pubDate} tags={p.data.tags} />)}
        {posts.length > 8 && <div style="text-align:center;padding:2rem 0;"><a href="/blog" class="more-btn">Wszystkie artykuły ({posts.length}) →</a></div>}
      </>
    ) : (
      <div class="empty"><p>✍️ Pierwsze artykuły pojawią się wkrótce.</p></div>
    )}
  </div>
</Layout>
<style>
.hero-text { padding: 3rem 0 2rem; border-bottom: 2px solid var(--green-pale); margin-bottom: 2rem; }
.hero-label { display: inline-block; background: var(--green-pale); color: var(--green); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.25rem 0.6rem; margin-bottom: 0.75rem; }
h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1rem; }
.lead { color: var(--text-muted); font-size: 1.1rem; max-width: 550px; }
.section-h { font-size: 1.1rem; color: var(--text-muted); font-family: 'Source Sans 3', sans-serif; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 0.5rem; border: none; }
.more-btn { border: 2px solid var(--green); color: var(--green); padding: 0.6rem 1.5rem; font-weight: 600; }
.empty { padding: 4rem 0; text-align: center; color: var(--text-muted); }
</style>

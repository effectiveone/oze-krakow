---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const dateStr = new Date(frontmatter.pubDate).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title={frontmatter.title} description={frontmatter.description}>
  <article class="container" style="padding-top:3rem;padding-bottom:4rem;">
    <header style="margin-bottom:2.5rem;">
      {frontmatter.tags?.map(t => <span class="ptag">{t}</span>)}
      <h1 style="font-size:clamp(1.8rem,4vw,2.8rem);margin:0.75rem 0 0.5rem;">{frontmatter.title}</h1>
      <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:0.5rem;">{dateStr} · {frontmatter.author}</p>
      <p style="font-size:1.1rem;color:var(--text-muted);font-style:italic;border-left:3px solid var(--green);padding-left:1rem;">{frontmatter.description}</p>
    </header>
    <div class="prose"><slot /></div>
  </article>
</Layout>
<style>
.ptag { background:var(--green-pale);color:var(--green);font-size:0.75rem;font-weight:600;padding:0.2rem 0.6rem;margin-right:0.4rem;text-transform:uppercase; }
.prose :global(h2) { font-size:1.5rem;margin:2rem 0 0.75rem;color:var(--green);border-bottom:2px solid var(--green-pale);padding-bottom:0.3rem; }
.prose :global(h3) { font-size:1.2rem;margin:1.5rem 0 0.5rem;color:var(--green-light); }
.prose :global(p) { margin-bottom:1.3rem;line-height:1.8; }
.prose :global(a) { color:var(--green);border-bottom:1px solid var(--border); }
</style>

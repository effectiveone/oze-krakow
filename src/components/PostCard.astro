---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  tags?: string[];
}
const { title, description, slug, pubDate, tags } = Astro.props;
const dateStr = new Date(pubDate).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class="post-card">
  <time>{dateStr}</time>
  {tags?.map(t => <span class="tag">{t}</span>)}
  <h2><a href={`/blog/${slug}`}>{title}</a></h2>
  <p>{description}</p>
  <a href={`/blog/${slug}`} class="read-link">Przeczytaj →</a>
</article>

<style>
.post-card { padding: 1.75rem 0; border-bottom: 1px solid var(--border); }
.post-card:last-child { border-bottom: none; }
time { color: var(--text-muted); font-size: 0.8rem; display: block; margin-bottom: 0.4rem; }
.tag { background: var(--green-pale); color: var(--green); font-size: 0.7rem; font-weight: 600; padding: 0.15rem 0.5rem; margin-right: 0.3rem; border-radius: 2px; text-transform: uppercase; letter-spacing: 0.04em; }
.post-card h2 { font-size: 1.35rem; font-weight: 700; margin: 0.5rem 0 0.6rem; }
.post-card h2 a { color: var(--text); }
.post-card h2 a:hover { color: var(--green); }
.post-card p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0.75rem; }
.read-link { color: var(--green); font-weight: 600; font-size: 0.9rem; border-bottom: 1px solid var(--green); }
</style>
